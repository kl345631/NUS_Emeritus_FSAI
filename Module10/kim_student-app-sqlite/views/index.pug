extends layout

block content
  h1 Student Course List
  h6 This is a program running on express with PUG
  a(href="/add") 
    button(type="button") ➕ Add Student
  ul
    each student in students
      li
        | #{student.name} - #{student.course}
        a(href=`/delete/${student.id}`)
            button(type="button" style="display: inline-block; margin-left: 10px;") ❌ Delete Student
